generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  passwordHash String?
  activities Activity[]
  sessions   Session[]
  createdAt  DateTime   @default(now())
}

model Session {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([participantId])
  @@index([expiresAt])
}

model Activity {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  type          ActivityType
  points        Int
  photoUrl      String
  activityDate  String
  createdAt     DateTime    @default(now())

  @@unique([participantId, activityDate, type])
  @@index([participantId])
  @@index([activityDate])
}

enum ActivityType {
  GYM
  RUNNING
  CYCLING
  WALKING
  SOCCER
}